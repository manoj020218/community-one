NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jenix-community-one

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# App
APP_NAME=Jenix Society One
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin Seed
SUPER_ADMIN_EMAIL=admin@jenix.in
SUPER_ADMIN_MOBILE=9999999999
SUPER_ADMIN_PASSWORD=Admin@123

# Billing platform bridge (mirrors the FireGuard <-> billing link)
# Shared secret the billing platform sends as X-Bridge-Secret to POST /api/bridge/provision
BRIDGE_SECRET=
# Public login URL returned to billing after provisioning (defaults to FRONTEND_URL/login)
APP_LOGIN_URL=
# Base URL of the billing platform, used by /api/auth/onboard-society to proxy signups
BILLING_API_BASE=https://iotsoft.in

# Google Sign-In (matches by email against already-provisioned accounts only)
GOOGLE_CLIENT_ID=
