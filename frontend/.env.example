# Google Sign-In (optional — the "Sign in with Google" button is hidden if unset)
# Must match GOOGLE_CLIENT_ID configured on the backend.
VITE_GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging (web push; optional — push registration is skipped if unset)
# Values come from Firebase Console -> Project Settings -> General -> Web app.
# VITE_FIREBASE_VAPID_KEY comes from Project Settings -> Cloud Messaging -> Web Push certificates.
# The same non-secret config must also be pasted into public/firebase-messaging-sw.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
