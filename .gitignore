# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.pio/
*.tsbuildinfo

# Environment files — never commit secrets
backend/.env
frontend/.env
frontend/.env.local
.env.local
.env.*.local

# Uploads directory (user-generated files)
backend/uploads/

# WhatsApp session credentials (per-society Baileys auth state — sensitive, never commit)
backend/whatsapp-sessions/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
coverage/
.nyc_output/

# pnpm
.pnpm-store/

# Vite
frontend/.vite/

# Capacitor — generated native project, regenerable via `npx cap add android`
frontend/android/
frontend/ios/

# Android signing — never commit keystores or their passwords
*.keystore
*.jks
